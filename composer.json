{
    "name": "jayanta/jeeves",
    "description": "A chat window for your own database. Users ask questions in plain English, Jeeves writes the SQL and runs it locally - the AI receives your schema structure only, never a row. Drop-in Blade widget, voice or text, any provider or a model you run yourself.",
    "keywords": [
        "laravel",
        "natural-language",
        "sql",
        "ai",
        "voice",
        "text-to-sql",
        "privacy",
        "database",
        "query",
        "gemini",
        "openai",
        "claude",
        "nl2sql",
        "self-hosted",
        "ollama",
        "gdpr",
        "local-llm",
        "reporting",
        "chat",
        "chatbot",
        "chat-widget",
        "conversational",
        "assistant",
        "ask-your-data"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Anta",
            "email": "jay123anta@gmail.com",
            "homepage": "https://github.com/jay123anta"
        }
    ],
    "homepage": "https://github.com/jay123anta/jeeves",
    "support": {
        "issues": "https://github.com/jay123anta/jeeves/issues",
        "source": "https://github.com/jay123anta/jeeves"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "suggest": {
        "jayanta/laravel-ai-guard": "Adds scoring-based prompt-injection, jailbreak and bot detection on top of the built-in input guard. Auto-detected -  no wiring required. Needs a version exposing detectText(string); v2.0.0 does not, and jeeves:doctor will say so."
    },
    "autoload": {
        "psr-4": {
            "Jayanta\\Jeeves\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jayanta\\Jeeves\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jayanta\\Jeeves\\JeevesServiceProvider"
            ],
            "aliases": {
                "Jeeves": "Jayanta\\Jeeves\\Facades\\Jeeves"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
