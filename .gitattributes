* text=auto

# Keep the distributed package lean -  dev-only files are not shipped to
# adopters via `composer require`.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/phpstan.neon.dist  export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore

# README media. It has to be committed so GitHub and Packagist can render it
# from a raw URL, but a multi-megabyte GIF has no business inside every
# `composer require` -  it would be downloaded into vendor/ by every adopter,
# forever, to be looked at by nobody.
/art                export-ignore
/docs/demo.gif      export-ignore
